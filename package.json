{
  "name": "@jupiterone/eslint-config",
  "version": "4.0.0",
  "description": "An opinionated eslint config for TypeScript projects with Vitest support",
  "repository": {
    "type": "git",
    "url": "https://github.com/JupiterOne/eslint-config"
  },
  "license": "MIT",
  "type": "module",
  "main": "flat/index.mjs",
  "exports": {
    "./flat": "./flat/index.mjs",
    "./flat/base": "./flat/base.mjs",
    "./flat/vitest": "./flat/vitest.mjs",
    "./flat/jest": "./flat/jest.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write '**/*.{js,mjs,ts,md,json}'",
    "lint": "eslint ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^9.39.0",
    "@vitest/eslint-plugin": "^1.6.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.32.1"
  },
  "devDependencies": {
    "@types/eslint__js": "^8.42.3",
    "eslint": "^9.39.0",
    "eslint-plugin-jest": "^29.12.1",
    "prettier": "^3.8.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": ">=9.0.0",
    "eslint-plugin-jest": ">=28.0.0",
    "typescript": ">=5.3.2"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint-plugin-jest": {
      "optional": true
    }
  },
  "files": [
    "LICENSE",
    "*.js",
    "*.mjs",
    "flat/",
    "*.md"
  ]
}
